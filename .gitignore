node_modules/

# مفاتيح API والتوكن الإداري — لا يجب أبدًا أن يتسربو لـ git
.env
.env.*

# مساهمات خام غير مراجعة بعد — بيانات وقت التشغيل فقط، لا تُتتبَّع في git.
# راجعها عبر GET /api/contribute?token=ADMIN_TOKEN ثم انقل الموثّق منها يدويًا
# إلى data/community-places.json (هذا الملف نفسه مُتتبَّع في git).
data/pending-contributions.json

# ملفات صوت مولّدة (cache) لـ/api/speak — يُعاد توليدها تلقائيًا عند الحاجة، لا تُتتبَّع في git
data/tts-cache/

# تبليغات صيدلية الحراسة — بيانات مؤقتة تنتهي صلاحيتها بعد 24 ساعة، لا تُتتبَّع في git
data/duty-reports.json

# تبرعات (معدات/أدوية) — تحتوي أرقام هواتف حقيقية، لا تُتتبَّع في git
data/donations.json

# إحصائية ضغطات زر المشاركة — عدّاد فقط لكن ولا هو من بيانات المشروع الأساسية، لا تُتتبَّع في git
data/share-analytics.json
